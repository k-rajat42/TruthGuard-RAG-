# --- LLM (Gemini) ---
GOOGLE_API_KEY=your-key-here
# Optional model overrides
# TRUTHGUARD_SYNTH_MODEL=gemini-2.5-flash
# TRUTHGUARD_CRITIC_MODEL=gemini-2.5-pro
# TRUTHGUARD_RESOLVER_MODEL=gemini-2.5-pro

# --- Qdrant ---
# ":memory:" (default) or a local folder path for persistence
# TRUTHGUARD_QDRANT_PATH=./qdrant_data

# --- Authority hierarchy override (JSON, higher number = higher authority) ---
# TRUTHGUARD_DOC_HIERARCHY={"regulation":5,"amendment":4,"policy":3,"memo":2,"faq":1}
